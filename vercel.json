{
  "installCommand": "cd frontend && npm install",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://streamly-backend-9q7i.onrender.com/api/:path*"
    },
    {
      "source": "/movie/:type/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(bot|facebook|twitter|discord|telegram).*"
        }
      ],
      "destination": "/api/og?type=$type&id=$id"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
