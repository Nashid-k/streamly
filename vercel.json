{
  "framework": "vite",
  "outputDirectory": "frontend/dist",
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/movie/:type/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(bot|facebook|twitter|discord|telegram).*"
        }
      ],
      "destination": "/api/og?type=$type&id=$id"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
