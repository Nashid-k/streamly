# ─── Backend API ──────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:4000/api
# Production: VITE_API_URL=https://streamly-backend-9q7i.onrender.com/api

# ─── Firebase Web SDK ─────────────────────────────────────────────────────────
# Get from: Firebase Console → Project Settings → Your apps → Web app (</>) → Config
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=1:your_sender_id:web:your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── App / URLs ────────────────────────────────────────────────────────────────
# Canonical site origin used for SEO/OpenGraph links
VITE_SITE_URL=your-site-origin
# Example: VITE_SITE_URL=https://streamlyvercelin.vercel.app/

# Key used to decode obfuscated trailer/stream URLs (XOR + base64)
# Keep in sync with the value used to encode URLs server-side.
VITE_URL_DECODE_KEY=your_url_decode_key_here
